  create  table "orderwave_db"."marts_marts"."dim_dates__dbt_tmp"
  
  
    as
  
  (
    SELECT DISTINCT
    order_date AS date_day,
    EXTRACT(YEAR FROM order_date)::int AS year,
    EXTRACT(MONTH FROM order_date)::int AS month,
