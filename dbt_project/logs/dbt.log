    TO_CHAR(order_date, 'Month') AS month_name,
    EXTRACT(DOW FROM order_date)::int AS day_of_week,
    TO_CHAR(order_date, 'Day') AS day_name
FROM "orderwave_db"."marts_staging"."stg_orders"
  );
  
